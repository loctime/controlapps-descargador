{
  "manifest_version": 3,
  "name": "ControlApps Descargador",
  "version": "1.0.0",
  "description": "Envia el video que estas viendo a ControlApps Descargador, con recorte opcional.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ControlApps Descargador",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
